from Crypto.Hash import CMAC
from Crypto.Cipher import AES

key = b'0123456789abcdef'

message = input("Enter Message: ").encode()

mac = CMAC.new(key, ciphermod=AES)
mac.update(message)

print("CBC-MAC:")
print(mac.hexdigest())

print("\nNote:")
print("CBC-MAC is secure only for fixed-length messages.")
