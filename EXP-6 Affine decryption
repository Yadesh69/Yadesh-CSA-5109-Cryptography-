import math

def mod_inverse(a, m):
    for i in range(1, m):
        if (a * i) % m == 1:
            return i
    return None

cipher = input("Enter Cipher Text: ").upper()

a = int(input("Enter value of a: "))
b = int(input("Enter value of b: "))

if math.gcd(a, 26) != 1:
    print("Invalid value of a")
else:
    a_inv = mod_inverse(a, 26)
    plain = ""

    for ch in cipher:
        if ch.isalpha():
            c = ord(ch) - ord('A')
            p = (a_inv * (c - b)) % 26
            plain += chr(p + ord('A'))
        else:
            plain += ch

    print("Decrypted Text:", plain)
