from collections import Counter

english_freq = "ETAOINSHRDLCUMWFGYPBVKJXQZ"

def frequency_attack(ciphertext, top=10):
    freq = Counter(c for c in ciphertext.upper() if c.isalpha())
    cipher_order = [x[0] for x in freq.most_common()]

    results = []

    for shift in range(top):
        mapping = {}

        for i, letter in enumerate(cipher_order):
            mapping[letter] = english_freq[(i + shift) % 26]

        plaintext = ""
        for ch in ciphertext.upper():
            plaintext += mapping.get(ch, ch)

        results.append(plaintext)

    return results


ciphertext = input("Enter ciphertext: ")
top = int(input("Enter number of possible plaintexts: "))

print("\nPossible Plaintexts:")
for i, text in enumerate(frequency_attack(ciphertext, top), 1):
    print(i, ":", text)
