import numpy as np

# Known plaintext and ciphertext pairs
P = np.array([[7, 4], [4, 11]])
C = np.array([[19, 8], [13, 18]])

# Find key matrix K = C * P^-1 (mod 26)
det = int(round(np.linalg.det(P)))
det_inv = pow(det % 26, -1, 26)

P_inv = det_inv * np.array([[P[1,1], -P[0,1]],
                            [-P[1,0], P[0,0]]])

K = (C @ P_inv) % 26

print("Recovered Key Matrix:")
print(K)
