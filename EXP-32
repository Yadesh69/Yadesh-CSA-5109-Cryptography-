import random

message = "HELLO"

# DSA: different random k for each signature
k1 = random.randint(1, 100)
k2 = random.randint(1, 100)

dsa_sig1 = hash(message) + k1
dsa_sig2 = hash(message) + k2

# RSA: same message gives same signature
rsa_sig1 = hash(message) * 2
rsa_sig2 = hash(message) * 2

print("Message:", message)

print("\nDSA Signatures:")
print("Signature 1:", dsa_sig1)
print("Signature 2:", dsa_sig2)

print("\nRSA Signatures:")
print("Signature 1:", rsa_sig1)
print("Signature 2:", rsa_sig2)
