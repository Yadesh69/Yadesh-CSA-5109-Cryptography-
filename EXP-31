def left_shift(x, bits):
    return (x << 1) & ((1 << bits) - 1)


def generate_subkeys(L, bits):
    # CMAC constants
    Rb = 0x1B if bits == 64 else 0x87

    # Generate K1
    K1 = left_shift(L, bits)
    if L & (1 << (bits - 1)):
        K1 ^= Rb

    # Generate K2
    K2 = left_shift(K1, bits)
    if K1 & (1 << (bits - 1)):
        K2 ^= Rb

    return K1, K2


# Example for 64-bit block
L = 0x8000000000000000

K1, K2 = generate_subkeys(L, 64)

print("L  =", hex(L))
print("K1 =", hex(K1))
print("K2 =", hex(K2))
